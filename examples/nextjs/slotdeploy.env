# slotdeploy config for a Next.js app (next build + next start behind systemd).
# Copy to /srv/myapp/slotdeploy.env and adjust.
REPO_URL=git@github.com:example/myapp.git
BRANCH=preview
ROOT=/srv/myapp

# Runs inside the idle slot. SLOTDEPLOY_SLOT / SLOTDEPLOY_SHA / SLOTDEPLOY_ROOT are set.
INSTALL_CMD=npm ci
BUILD_CMD=npm run build
# Must pass before the link is switched.
CHECK_CMD=test -f .next/BUILD_ID

# The app service runs from /srv/myapp/current (see myapp.service).
RESTART_CMD=sudo systemctl restart myapp
HEALTH_URL=http://127.0.0.1:3000/
HEALTH_RETRIES=30
HEALTH_INTERVAL=2

# Files that are not in git (.env.production etc.) are copied into each slot.
SHARED_DIR=/srv/myapp/shared
# Kept between builds of the same slot (space separated).
KEEP=node_modules .next/cache
