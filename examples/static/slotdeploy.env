# slotdeploy config for any static site (plain HTML, Hugo, Vite, ...).
# The web server (nginx.conf here) serves /srv/site/current/public, so no restart is needed.
REPO_URL=https://github.com/example/site.git
BRANCH=preview
ROOT=/srv/site

# Plain HTML needs no build. For Vite use: INSTALL_CMD=npm ci / BUILD_CMD=npm run build
BUILD_CMD=
CHECK_CMD=test -f public/index.html

RESTART_CMD=
HEALTH_URL=http://127.0.0.1:8080/
HEALTH_RETRIES=5
HEALTH_INTERVAL=1
