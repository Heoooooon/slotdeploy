#!/usr/bin/env bash
# Generate configuration and user-scoped schedulers; never activate services.
set -euo pipefail

die() { printf 'slotdeploy init: %s\n' "$*" >&2; exit 1; }
usage() {
  cat <<'EOF'
Usage: slotdeploy init [--yes] [options]
  --config PATH       Config file (default: ./slotdeploy.env)
  --repo URL          Git repository URL (required with --yes)
  --root PATH         Absolute deployment directory
  --branch NAME       Watched branch (default: preview)
  --install CMD       Dependency installation command
  --build CMD         Build command
  --check CMD         Pre-switch check command
  --restart CMD       Restart command
  --health-url URL    Post-switch health check URL
  --timer TYPE        systemd, launchd, or none (default: host platform)
  --timer-dir PATH    Scheduler output directory
  --every SECONDS     Check interval (default: 60)
  --name NAME         Scheduler name (default: slotdeploy-watch)
  --yes               Use flags/defaults without questions
Existing files are never overwritten. Generated timers are not activated.
EOF
}

config=./slotdeploy.env
repo="" root="$HOME/slotdeploy" branch=preview
install_cmd="" build="" check="" restart="" health=""
timer="" timer_dir="" every=60 name=slotdeploy-watch yes=""
case $(uname -s) in Darwin) timer=launchd ;; *) timer=systemd ;; esac
while [ $# -gt 0 ]; do
  case $1 in
    --help | -h) usage; exit 0 ;;
    --yes) yes=1; shift; continue ;;
    --config | --repo | --root | --branch | --install | --build | --check | \
      --restart | --health-url | --timer | --timer-dir | --every | --name)
      [ $# -ge 2 ] || die "$1 needs a value"
      case $1 in
        --config) config=$2 ;; --repo) repo=$2 ;; --root) root=$2 ;;
        --branch) branch=$2 ;; --install) install_cmd=$2 ;; --build) build=$2 ;;
        --check) check=$2 ;; --restart) restart=$2 ;; --health-url) health=$2 ;;
        --timer) timer=$2 ;; --timer-dir) timer_dir=$2 ;; --every) every=$2 ;;
        --name) name=$2 ;;
      esac
      shift 2 ;;
    *) die "unknown option: $1" ;;
  esac
done

ask() {
  local answer
  printf '%s [%s]: ' "$1" "$2" >&2
  IFS= read -r answer || die "input ended; use --yes for unattended setup"
  printf '%s' "${answer:-$2}"
}
if [ -z "$yes" ]; then
  repo=$(ask "Repository URL" "$repo")
  root=$(ask "Deployment directory" "$root")
  branch=$(ask "Watched branch" "$branch")
  build=$(ask "Build command (empty for static files)" "$build")
  restart=$(ask "Restart command (empty for static files)" "$restart")
  health=$(ask "Health URL (empty to disable)" "$health")
  timer=$(ask "Timer (systemd/launchd/none)" "$timer")
fi

# Values are serialized, not evaluated. Reject additional config/XML lines.
for value in "$config" "$repo" "$root" "$branch" "$install_cmd" "$build" \
  "$check" "$restart" "$health" "$timer_dir" "$name"; do
  case $value in *$'\n'* | *$'\r'*) die "values must be single-line" ;; esac
done
[ -n "$repo" ] || die "--repo is required"
case $root in /*) ;; \~) root=$HOME ;; \~/*) root="$HOME/${root#\~/}" ;;
  *) die "--root must be an absolute path" ;; esac
case $branch in '' | *[[:space:]]*) die "--branch is invalid" ;; esac
git check-ref-format --branch "$branch" >/dev/null 2>&1 || die "--branch is invalid"
case $every in '' | *[!0-9]* | 0) die "--every must be a positive integer" ;; esac
case $every in *[1-9]*) ;; *) die "--every must be a positive integer" ;; esac
case $name in '' | *[!a-zA-Z0-9._-]*) die "--name must contain letters, digits, '.', '_' or '-'" ;; esac
case $timer in systemd | launchd | none) ;; *) die "--timer must be systemd, launchd, or none" ;; esac
[ ! -e "$config" ] && [ ! -L "$config" ] || die "config already exists"

bin_dir=$(cd "$(dirname "$0")" && pwd)
binary="$bin_dir/slotdeploy"
mkdir -p "$(dirname "$config")"
config="$(cd "$(dirname "$config")" && pwd)/$(basename "$config")"
service="" schedule=""
case $timer in
  systemd)
    timer_dir=${timer_dir:-"$HOME/.config/systemd/user"}
    service="$timer_dir/$name.service"
    schedule="$timer_dir/$name.timer" ;;
  launchd)
    timer_dir=${timer_dir:-"$HOME/Library/LaunchAgents"}
    schedule="$timer_dir/$name.plist" ;;
esac
for file in "$service" "$schedule"; do
  [ -z "$file" ] || { [ ! -e "$file" ] && [ ! -L "$file" ]; } ||
    die "scheduler file already exists"
done

systemd_quote() {
  local s=$1
  s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//%/%%}
  printf '"%s"' "$s"
}
xml() {
  local s=$1
  s=${s//&/\&amp;}; s=${s//</\&lt;}; s=${s//>/\&gt;}
  s=${s//\"/\&quot;}; s=${s//\'/\&apos;}
  printf '%s' "$s"
}

umask 077
stage=$(mktemp -d "${TMPDIR:-/tmp}/slotdeploy-init.XXXXXX")
trap 'rm -rf "$stage"' EXIT
{
  printf '# Generated by slotdeploy init. Values are never evaluated on load.\n'
  printf 'REPO_URL=%s\nBRANCH=%s\nROOT=%s\n' "$repo" "$branch" "$root"
  printf 'INSTALL_CMD=%s\nBUILD_CMD=%s\nCHECK_CMD=%s\n' "$install_cmd" "$build" "$check"
  printf 'RESTART_CMD=%s\nHEALTH_URL=%s\n' "$restart" "$health"
} >"$stage/config"
case $timer in
  systemd)
    {
      printf '[Unit]\nDescription=slotdeploy preview watcher\n\n[Service]\nType=oneshot\n'
      printf 'Environment=%s\n' \
        "$(systemd_quote "PATH=$bin_dir:/usr/local/bin:/usr/bin:/bin")"
      printf 'ExecStart=%s -c %s watch\n' "$(systemd_quote "$binary")" "$(systemd_quote "$config")"
      printf 'SuccessExitStatus=1\n'
    } >"$stage/service"
    printf '[Unit]\nDescription=slotdeploy preview timer\n\n[Timer]\nOnBootSec=%ss\nOnUnitActiveSec=%ss\nUnit=%s.service\n\n[Install]\nWantedBy=timers.target\n' \
      "$every" "$every" "$name" >"$stage/schedule" ;;
  launchd)
    {
      printf '<?xml version="1.0" encoding="UTF-8"?>\n<plist version="1.0"><dict>\n'
      printf '<key>Label</key><string>%s</string>\n' "$(xml "$name")"
      printf '<key>ProgramArguments</key><array><string>%s</string><string>-c</string><string>%s</string><string>watch</string></array>\n' \
        "$(xml "$binary")" "$(xml "$config")"
      printf '<key>StartInterval</key><integer>%s</integer>\n' "$every"
      printf '<key>EnvironmentVariables</key><dict><key>PATH</key><string>%s:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>\n' "$(xml "$bin_dir")"
      printf '</dict></plist>\n'
    } >"$stage/schedule" ;;
esac
# noclobber closes the race between validation and publishing.
(set -C; cat "$stage/config" >"$config") || die "could not create config"
[ -z "$timer_dir" ] || mkdir -p "$timer_dir"
[ -z "$service" ] || (set -C; cat "$stage/service" >"$service")
[ -z "$schedule" ] || (set -C; cat "$stage/schedule" >"$schedule")
printf 'Created config: %s\n' "$config"
case $timer in
  systemd)
    printf 'Created user timer: %s\nActivate: systemctl --user daemon-reload && systemctl --user enable --now %s.timer\n' "$schedule" "$name"
    printf 'For watching after logout: loginctl enable-linger "%s"\n' "${USER:-$(id -un)}" ;;
  launchd)
    printf 'Created user agent: %s\nActivate: launchctl bootstrap gui/%s "%s"\n' "$schedule" "$(id -u)" "$schedule" ;;
esac
printf 'First deploy: "%s" -c "%s" deploy\n' "$binary" "$config"
